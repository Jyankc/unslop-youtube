{
  "manifest_version": 3,
  "name": "Unslop YouTube",
  "version": "1.2.0",
  "description": "A quiet YouTube. Just search, choose a video, and watch without recommendations.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Unslop YouTube",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
    "css": ["quiet.css"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
